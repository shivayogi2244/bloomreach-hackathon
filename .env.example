# ---- Gemini / Google Cloud ----
GEMINI_API_KEY=your-ai-studio-key
GEMINI_MODEL=gemini-2.5-flash
# For Vertex AI instead: GOOGLE_CLOUD_PROJECT=my-project, GOOGLE_CLOUD_LOCATION=global

# ---- Master switch: mock everything ----
USE_MOCKS=true

# ---- Databricks ----
DATABRICKS_HOST=adb-xxxx.azuredatabricks.net   # or dbc-xxxx.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_TABLE=main.default.loop_segments    # must match sql/setup.sql

# ---- Shopify ----
SHOPIFY_SHOP=yourshop.myshopify.com
SHOPIFY_TOKEN=shpat_xxx
SHOPIFY_API_VERSION=2024-10

# ---- Bloomreach ----
BLOOMREACH_PROJECT_ID=
BLOOMREACH_API_KEY=
BLOOMREACH_CAMPAIGN_ID=
BLOOMREACH_BASE_URL=https://api.exponea.com
